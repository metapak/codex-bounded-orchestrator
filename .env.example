# Copy values into your shell or a local .env loader. X Autopilot never reads this file automatically.
OPENAI_API_KEY=
# Optional; raises GitHub's public API rate limit.
GITHUB_TOKEN=

# Cloud: use Railway sealed service variables. Do not commit real values.
DATABASE_URL=
PUBLIC_URL=
REVIEW_USERNAME=
REVIEW_PASSWORD=
# OAuth 1.0a user context for one X account with write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Only switches on delivery of human-approved drafts; never automatic approval.
X_PUBLISH_ENABLED=false
SCHEDULER_ENABLED=true
