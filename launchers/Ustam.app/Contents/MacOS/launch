#!/bin/sh

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
launcher="$launcher_dir/launchers/launch_dashboard.py"

if [ -z "${BO_LANG:-}" ]; then
    preferred_language=$(defaults read -g AppleLanguages 2>/dev/null | awk -F '"' 'NF >= 2 { print $2; exit }')
    preferred_language=${preferred_language:-${LC_ALL:-${LANG:-en}}}
    case "$preferred_language" in
        tr|tr-*|tr_*) BO_LANG=tr ;;
        *) BO_LANG=en ;;
    esac
fi
export BO_LANG

if [ ! -f "$launcher" ]; then
    if [ "$BO_LANG" = tr ]; then
        guide_script='display dialog "Önce kurulum paketinin klasörünü bulacağız." & return & return & "İndirilenler klasöründe, indirdiğiniz Ustam ZIP dosyasından çıkan DIŞ klasörü seçin. İçinde launchers ve scripts klasörleri olmalı." & return & return & "Kendi Codex proje klasörünüzü burada seçmeyin. Onu 2. adımda seçeceksiniz." buttons {"Vazgeç", "Devam"} default button "Devam" cancel button "Vazgeç" with title "1/2 · Kurulum paketi"'
        picker_script='POSIX path of (choose folder with prompt "1/2 · ZIP dosyasından çıkan ana klasörü seçin" default location (path to downloads folder))'
        wrong_script='display alert "Yanlış klasör" message "İndirilenler klasöründeki, indirdiğiniz Ustam ZIP dosyasından çıkan DIŞ klasörü seçin. İçinde launchers ve scripts olmalı." & return & return & "Codex projenizi 2. adımda seçeceksiniz." buttons {"Vazgeç", "Yeniden dene"} default button "Yeniden dene" cancel button "Vazgeç" as warning'
        cancel_script='display alert "Kurulum iptal edildi" message "Uygulamayı yeniden açarak kurulum paketi klasörünü seçebilirsiniz."'
        error_script='display alert "Kurulum konsolu açılamadı" message "Kurulum paketi klasörü seçilemedi." as warning'
    else
        guide_script='display dialog "First, find the setup package folder." & return & return & "In Downloads, choose the OUTER folder extracted from the downloaded Ustam ZIP. It contains launchers and scripts." & return & return & "Do not choose your Codex project yet. You will choose it in step 2." buttons {"Cancel", "Continue"} default button "Continue" cancel button "Cancel" with title "1/2 · Setup package"'
        picker_script='POSIX path of (choose folder with prompt "1/2 · Select the folder extracted from the ZIP" default location (path to downloads folder))'
        wrong_script='display alert "Wrong folder" message "In Downloads, choose the OUTER folder extracted from the downloaded Ustam ZIP. It must contain launchers and scripts." & return & return & "Choose your Codex project in step 2." buttons {"Cancel", "Try again"} default button "Try again" cancel button "Cancel" as warning'
        cancel_script='display alert "Setup canceled" message "Reopen the app to choose the setup package folder."'
        error_script='display alert "Setup console unavailable" message "Could not choose the setup package folder." as warning'
    fi
    guide=$(/usr/bin/osascript -e "$guide_script" 2>&1)
    guide_status=$?
    if [ "$guide_status" -ne 0 ]; then
        case "$guide" in *-128*) exit 0 ;; esac
        /usr/bin/osascript -e "$error_script"
        exit 1
    fi
    while :; do
        selected=$(/usr/bin/osascript -e "$picker_script" 2>&1)
        choice_status=$?
        if [ "$choice_status" -ne 0 ]; then
            case "$selected" in
                *-128*)
                    /usr/bin/osascript -e "$cancel_script"
                    exit 0
                    ;;
            esac
            /usr/bin/osascript -e "$error_script"
            exit 1
        fi
        case "$selected" in
            */launchers/) selected=${selected%/launchers/} ;;
            */launchers) selected=${selected%/launchers} ;;
        esac
        if [ -f "$selected/launchers/launch_dashboard.py" ] && [ -f "$selected/scripts/dashboard.py" ]; then
            launcher="$selected/launchers/launch_dashboard.py"
            break
        fi
        retry=$(/usr/bin/osascript -e "$wrong_script" 2>&1)
        retry_status=$?
        if [ "$retry_status" -ne 0 ]; then
            case "$retry" in *-128*) exit 0 ;; esac
            exit 1
        fi
    done
fi

for python in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3.13 python3.12 python3.11 python3; do
    if command -v "$python" >/dev/null 2>&1 &&
        "$python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$python" "$launcher"
    fi
done

/usr/bin/osascript -e 'display alert "Python 3.11 or newer is needed" message "Install Python 3.11 or newer, then open Ustam again." as warning'
